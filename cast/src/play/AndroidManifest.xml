<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- CastOptionsProvider for Cast SDK initialization -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.cascadiacollections.sir.cast.CastOptionsProvider" />

        <!-- Bootstraps CastSessionCoordinator at process start; see its kdoc. -->
        <provider
            android:name="com.cascadiacollections.sir.cast.CastAutoInitializer"
            android:authorities="${applicationId}.castautoinitializer"
            android:exported="false" />
    </application>

</manifest>
