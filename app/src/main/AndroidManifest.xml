<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS"
        tools:targetApi="tiramisu" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        tools:targetApi="s" />

    <!-- "What's playing?" speaks its answer; package visibility (API 30+) has to let the
         TextToSpeech client see the installed engines. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- ChromeOS compatibility: touchscreen not required -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <!-- Android TV (TvActivity) is supported but not required -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <application
        android:name=".SirApp"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Sir"
        tools:targetApi="tiramisu">

        <!-- Android Auto / Automotive OS media support -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Sir.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sir" android:host="station" />
            </intent-filter>
            <!-- Voice search ("Play [station name]") when SIR isn't already the active
                 media app — see MainActivity.handlePlayFromSearch. -->
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <!-- Android TV home (ShoutKit's tvOS app): only the TV launcher lists it. -->
        <activity
            android:name=".TvActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:banner="@drawable/tv_banner"
            android:theme="@style/Theme.Sir">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Headless voice/shortcut actions (static shortcuts + App Actions capabilities in
             res/xml/shortcuts.xml). Exported with an explicit action each, so Assistant and
             `adb shell am start` can reach them; neither takes input from the intent. -->
        <activity
            android:name=".NowPlayingAnnounceActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:label="@string/shortcut_whats_playing_long"
            android:theme="@style/Theme.Sir.Headless">
            <intent-filter>
                <action android:name="com.cascadiacollections.sir.action.WHATS_PLAYING" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".FavoriteCurrentStationActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:label="@string/shortcut_favorite_long"
            android:theme="@style/Theme.Sir.Headless">
            <intent-filter>
                <action android:name="com.cascadiacollections.sir.action.FAVORITE_CURRENT_STATION" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <service
            android:name=".RadioPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:enabled="true">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
        <service
            android:name=".RadioTileService"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:label="@string/station_name"
            android:icon="@drawable/ic_launcher_foreground">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- Quick Play widget: pick which saved station it plays -->
        <activity
            android:name=".QuickPlayConfigActivity"
            android:exported="true"
            android:label="@string/quick_play_choose_station"
            android:theme="@style/Theme.Sir">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".RadioWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/radio_widget_info" />
        </receiver>
    </application>

</manifest>
